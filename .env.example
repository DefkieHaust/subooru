GELBOORU_USER_ID=
GELBOORU_API_KEY=
HOST=0.0.0.0
PORT=3000

# Cloudflare Worker URL for proxying media (optional, client-side)
# If unset, media loads through the Express server instead.
# After deploying the worker (cd subooru-worker && wrangler deploy),
# replace the value below with the URL wrangler outputs.
VITE_WORKER_BASE=https://subooru-media.your-subdomain.workers.dev
