GELBOORU_USER_ID=
GELBOORU_API_KEY=

# Danbooru API credentials (optional; unauthenticated requests work with lower rate limits)
DANBOORU_USERNAME=
DANBOORU_API_KEY=


HOST=0.0.0.0
PORT=3000

# Redis URL for caching and rate limiting (optional)
# If unset, falls back to in-memory cache and rate limiting.
# REDIS_URL=redis://localhost:6379

# S3-compatible media cache (optional)
# If set, media files are cached to S3 instead of being re-fetched from Gelbooru.
# S3_ENDPOINT=localhost
# S3_PORT=9000
# S3_USE_SSL=false
# S3_REGION=us-east-1
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=subooru-media
